{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Resume PDF",
			"type": "shell",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "silent"
			},
			"osx": {
				"command": ".devcontainer/exec.sh xelatex -interaction=nonstopmode main.tex && open -a Preview main.pdf"
			},
			"linux": {
				"command": "if [ -f /.dockerenv ]; then xelatex -interaction=nonstopmode main.tex; else .devcontainer/exec.sh xelatex -interaction=nonstopmode main.tex && xdg-open main.pdf; fi"
			},
			"windows": {
				"command": "bash .devcontainer/exec.sh xelatex -interaction=nonstopmode main.tex"
			}
		}
	]
}
